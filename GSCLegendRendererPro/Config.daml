<ArcGIS defaultAssembly="GSCLegendRendererPro.dll" defaultNamespace="GSCLegendRendererPro" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Users/ghuotvez/AppData/Local/Programs/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{b7ab16a1-0c66-48dd-9d98-e39529ab9053}" version="2.1" desktopVersion="3.5.57366" product="ArcGISPro">
    <Name>GSC Legend Renderer</Name>
    <Description>This tool is meant to create a graphic legend inside ArcGIS, from a given legend table.</Description>
    <Image>Images\AddInDesktop32.png</Image>
    <Author>Geological Survey Canada - Commission géologique du Canada</Author>
    <Company>Government of Canada - Gouvernement du Canada; Natural Resources Canada - Ressources naturelles Canada</Company>
    <Date>7/30/2026 12:00:00 AM</Date>
    <Subject>Framework, Layout, Map, Geoscience, Cartography, GSC, Geology, Bedrock, Surficial</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>
  <modules>
    <insertModule id="GSCLegendRendererPro_Module" className="LegendModule" autoLoad="true" caption="GSC Layout Module">
      <tabs>
        <tab id="GSCLegendRendererPro_Tab" caption="Legend" keytip="Legend">
          <group refID="Legend_Layout" />
          <group refID="Legend_Help" />
        </tab>-
      </tabs>
      <groups>
        <group id="Legend_Layout" caption="Layout" appearsOnAddInTab="false" keytip="Layout">
          <button refID="GSCLegendRendererPro_Button_Legend_Renderer" size="large" />
        </group>
        <group id="Legend_Help" caption="Help" appearsOnAddInTab="false" keytip="Help">
          <button refID="GSCLegendRendererPro_Button_Help" size="large" />
        </group>
      </groups>
      <controls>
        <!-- add your controls here -->
        <button id="GSCLegendRendererPro_Button_Legend_Renderer" keytip="Layout" caption="Create Legend" className="Buttons.Button_Legend_Renderer" loadOnClick="true" smallImage="Legend16" largeImage="Legend32">
          <tooltip heading="Legend">
				Specialized tool that will produce a graphic legend from an input legend table.<disabledText /></tooltip>
        </button>
        <button id="GSCLegendRendererPro_Button_Help" keytip="Help, about and more online resources" caption="About" className="Buttons.Button_Help" loadOnClick="true" smallImage="pack://application:,,,/GSCLegendRendererPro;component/Images/Hammer16.png" largeImage="pack://application:,,,/GSCLegendRendererPro;component/Images/Hammer32.png">
          <tooltip heading="Help">
				Help, about and more online resources<disabledText /></tooltip>
        </button>
      </controls>
    </insertModule>
  </modules>
</ArcGIS>